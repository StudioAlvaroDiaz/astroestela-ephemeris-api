# Copiar a .env (nunca subir .env al repositorio).

# Secreto(s) HMAC compartidos con WordPress, separados por comas.
# Generar con: openssl rand -hex 32
# Para rotar: añadir el nuevo al principio, actualizar WordPress, quitar el viejo.
EPHEM_HMAC_SECRETS=

# Dominio público de la API.
EPHEM_HOST=api-staging.astroestela.com

# IPs (o rangos CIDR) que pueden usar /v1/*, separadas por comas.
# IP de salida del hosting de WordPress (staging).
EPHEM_ALLOWED_IPS=89.116.114.24

# Versión desplegada (aparece en /health) y URL del código fuente (AGPL).
EPHEM_VERSION=0.1.0
EPHEM_SOURCE_URL=https://github.com/StudioAlvaroDiaz/astroestela-ephemeris-api
